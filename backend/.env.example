# Copy to backend/.env and edit. backend/.env is git-ignored: never commit it.

# live = Open-Meteo forecast (needs internet); replay = archive data in the repo (needs ?date=YYYY-MM-DD)
PAWANG_DATA_MODE=live

# Self-hosted Qwen via an OpenAI-compatible server
#   Ollama:  ollama pull qwen3.5:4b   -> QWEN_BASE_URL=http://localhost:11434/v1
#   vLLM:    vllm serve <qwen model> -> QWEN_BASE_URL=http://<gpu-server>:8000/v1
QWEN_ENABLED=true
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen3.5:4b
QWEN_API_KEY=not-needed
QWEN_TIMEOUT_S=60
# ollama = native API, thinking off (recommended for Qwen 3.x); openai = OpenAI-compatible (vLLM, LM Studio)
QWEN_API_STYLE=ollama

# Cache TTL in seconds (document: 10-15 minutes)
PAWANG_CACHE_TTL_S=600
